# ==============================================================================
# StatSkill AI — Environment Configuration Specification (.env.example)
# ==============================================================================

# Environment mode: 'development' or 'production'
# In 'production' mode, STATSKILL_ADMIN_KEY MUST be explicitly configured.
ENVIRONMENT=development

# Server Ports
PORT=8000
FRONTEND_PORT=5173

# Admin Security Key
# In development: defaults to 'dev-admin-key' if omitted.
# In production: application refuses to start if unset or left as default.
STATSKILL_ADMIN_KEY=your-secure-random-admin-key-min-32-chars

# CORS Allowed Origins (Comma-separated, never wildcard with credentials)
STATSKILL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:80,http://localhost

# File Upload Security Limits
# Maximum upload file size in bytes (Default: 26214400 = 25 MB)
STATSKILL_MAX_UPLOAD_SIZE=26214400
# Upload directory path
STATSKILL_UPLOAD_DIR=backend/uploads

# Data & Session Storage
# Database path for persistent SQLite sessions
STATSKILL_SESSIONS_DB=backend/sessions.db
# Primary JSON dataset path for local development
STATSKILL_DATA_FILE=backend/statskill.json
STATSKILL_DEMO_FILE=backend/demo.json
STATSKILL_DATA_SOURCES_FILE=backend/data_sources.json

# Optional External AI API Keys (StatSkill includes deterministic fallback generators)
GEMINI_API_KEY=
OPENAI_API_KEY=

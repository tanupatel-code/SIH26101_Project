# ==========================================
# StatSkill AI — Environment Configuration Example
# ==========================================

# Port Configuration
PORT=8000
FRONTEND_PORT=5173

# Security & Admin Access
STATSKILL_ADMIN_KEY=dev-admin-key-change-in-production

# CORS Allowed Origins (comma separated)
STATSKILL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:80,http://localhost

# Optional Cloud LLM API Keys (Falls back to high-fidelity local MoSPI/NSSTA generator if not set)
GEMINI_API_KEY=
OPENAI_API_KEY=

# File Paths (Defaults to backend/statskill.json and backend/demo.json)
# STATSKILL_DATA_FILE=backend/statskill.json
# STATSKILL_DEMO_FILE=backend/demo.json
